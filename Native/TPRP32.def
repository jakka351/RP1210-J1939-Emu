; Tester Present RP1210 emulator (TPRP32.dll).
; A .def gives clean, undecorated export names so RP1210 hosts bind RP1210_* by plain name
; (x86 __stdcall would otherwise decorate them as _RP1210_ClientConnect@24, etc.).
EXPORTS
    RP1210_ClientConnect
    RP1210_ClientDisconnect
    RP1210_SendMessage
    RP1210_ReadMessage
    RP1210_SendCommand
    RP1210_ReadVersion
    RP1210_ReadDetailedVersion
    RP1210_GetHardwareStatus
    RP1210_GetErrorMsg
    ; management / configuration control ABI (emulator GUI console)
    emu_node_count
    emu_node_info
    emu_inject_dtc
    emu_clear_dtcs
    emu_get_vin
    emu_set_vin
    emu_set_fault
    emu_flash_active
    emu_running
    emu_signal_count
    emu_signal_info
    emu_set_signal
